#!/usr/bin/env bash
# Contributor guardrails (opt in once per clone: git config core.hooksPath .githooks).
# Refuses pushes to main and integration/*, and force pushes. Runs the Nexo client checks
# when the pushed commits touch frontends/nexo. Overrides, for the maintainer only:
# LAB_ALLOW_PROTECTED=1, LAB_ALLOW_FORCE=1, LAB_SKIP_CHECKS=1.
set -u
zero=0000000000000000000000000000000000000000
stop() { echo "pre-push: $1" >&2; exit 1; }
nexo=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  [ "$local_sha" = "$zero" ] && continue   # deleting a remote branch
  case "$remote_ref" in
    refs/heads/main|refs/heads/integration/*)
      [ "${LAB_ALLOW_PROTECTED:-}" = 1 ] || stop "do not push to ${remote_ref#refs/heads/}. Push your topic branch and open a pull request." ;;
  esac
  if [ "$remote_sha" != "$zero" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      [ "${LAB_ALLOW_FORCE:-}" = 1 ] || stop "this push rewrites ${remote_ref#refs/heads/} (force push). Merge the remote branch instead: git pull --no-rebase"
    fi
    range="$remote_sha..$local_sha"
  else
    range=$(git merge-base "$local_sha" origin/integration/libreros-guided-workflow 2>/dev/null)..$local_sha
  fi
  git diff --name-only "$range" 2>/dev/null | grep -q '^frontends/nexo/' && nexo=1
done

if [ "$nexo" = 1 ] && [ "${LAB_SKIP_CHECKS:-}" != 1 ]; then
  root=$(git rev-parse --show-toplevel)
  [ -d "$root/frontends/nexo/node_modules" ] || stop "frontends/nexo changed but its node_modules is missing: run npm ci in frontends/nexo, then push again."
  echo "pre-push: frontends/nexo changed, running tsc and vitest…" >&2
  (cd "$root/frontends/nexo" && npx tsc --noEmit && npx vitest run --reporter=dot) || stop "the Nexo checks failed. Fix them before pushing."
fi
exit 0
