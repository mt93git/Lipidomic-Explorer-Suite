# Leave both values empty to run with example data and a demo identity.
# For live sign-in, supply the project's public URL and anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, public: Open Team links to NEXT_PUBLIC_TEAM_URL; Open in Nexo links to
# <NEXT_PUBLIC_NEXO_URL>/?dataset=<id> on a released, current dataset (lab staff only, unless
# NEXT_PUBLIC_NEXO_CLIENT_ACCESS=1 also shows it to client members: keep it unset in production until
# Nexo's own store is scoped per client; docs/integration/admin-identity.md).
# NEXT_PUBLIC_TEAM_URL=
# NEXT_PUBLIC_NEXO_URL=
# NEXT_PUBLIC_NEXO_CLIENT_ACCESS=1

# Server-only secret for accepting invitations on /invite/<token> (the app server creates the invited person's
# account, as GoTrue self sign-up is off, and calls admin.accept_invitation). Never NEXT_PUBLIC_, never committed.
# Without it, live invitations can be created but not accepted. The e2e seed below reads the same variable.
# SUPABASE_SERVICE_ROLE_KEY=

# Force example mode even when Supabase settings are present:
# ADMIN_MOCK=1

# Fonts are fetched by next/font at build time. Auto mode uses system fallbacks
# if Google Fonts is unreachable. Use google to require the brand fonts.
# ADMIN_FONT_MODE=google
# ADMIN_FONT_MODE=system

# Staging E2E (e2e/live/live.spec.ts + e2e/live/seed.mjs). Skipped unless ADMIN_E2E_LIVE=1.
# Throwaway test users on reserved test domains only (the seed resets their passwords and TOTP factor).
# Set these in your shell or an untracked env file; never commit values.
# ADMIN_E2E_LIVE=1
# ADMIN_E2E_OPERATOR_EMAIL=e2e-operator@example.test
# ADMIN_E2E_OPERATOR_PASSWORD=
# ADMIN_E2E_CLIENT_EMAIL=e2e-client@example.test
# ADMIN_E2E_CLIENT_PASSWORD=
# Seed only (server-side secret, never exposed to the app):
# SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct GoTrue / PostgREST URLs when there is no gateway; ADMIN_E2E_TOTP=0 skips the factor.
# ADMIN_E2E_AUTH_URL=
# ADMIN_E2E_REST_URL=
# ADMIN_E2E_TOTP=0
