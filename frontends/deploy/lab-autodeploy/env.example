# ~/.config/lab-autodeploy/<env>.env, one per environment (staging, production). Read by autodeploy.sh.
BRANCH=lab/main                     # staging: lab/main; production: lab/production
HOST=                               # public host name of the site
NGINX=http://127.0.0.1              # where nginx listens on this machine
# Nexo: the checkout that serves its API (and, if separate, the collaboration service's), the client's web root,
# the client's base path and build variables, ports and systemd user units.
NEXO_DIR=
#NEXO_COLLAB_DIR=
NEXO_DIST=
NEXO_BASE=/nexo-staging/
NEXO_BUILD_ENV="VITE_API_BASE=/nexo-staging/api/v1 VITE_ADMIN_BASE=/admin-staging VITE_ADMIN_TOKEN_URL=/admin-staging/api/session-token VITE_COLLAB_URL=wss://<host>/nexo-staging/collab"
NEXO_API_PORT=3971
NEXO_COLLAB_PORT=3975
NEXO_UNITS="nexo-admin-staging.service nexo-collab-staging.service"
#COLLAB_DATA_DIR=                   # production: backed up before each deploy
#NEXO_VENDOR_DIR=                   # client vendor files that are not in git
# Admin: its checkout, the env file it is built and run with, its unit, port, base path and database container.
ADMIN_DIR=
ADMIN_ENV_FILE=
ADMIN_UNIT=
ADMIN_PORT=3980
ADMIN_BASE=/admin-staging
ADMIN_DB=
# R for the syntax check.
#RSCRIPT=Rscript
#R_LIBS_USER=
