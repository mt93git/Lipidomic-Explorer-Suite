# ~/.config/admin-results-check/<env>.env, one per environment (staging, production). chmod 600.
# Admin's public URL with its base path, no trailing slash: https://<host>/admin or https://<host>/admin-staging
ADMIN_URL=
# The same value as ADMIN_CRON_SECRET in that Admin's environment file (openssl rand -hex 32).
ADMIN_CRON_SECRET=
