# nexo-collab sidecar environment (src/server.mjs). Copy to an untracked env file; placeholder values only here.
COLLAB_PORT=<collab-port>
COLLAB_DB=<data-dir>/collab.sqlite
# Optional; the WebSocket and HTTP routes live under this path.
COLLAB_PATH=/collab
# Admin PostgREST (admin.nexo_caller) and its anon key.
ADMIN_REST_URL=http://127.0.0.1:<admin-rest-port>
ADMIN_ANON_KEY=<admin-anon-key>
# Nexo R API on loopback and the HS256 secret it shares with the sidecar (X-Nexo-Service-Token).
# Leave either unset and the board still works, but no R session is opened.
NEXO_API_URL=http://127.0.0.1:<nexo-api-port>
NEXO_SERVICE_SECRET=<shared-service-secret>
