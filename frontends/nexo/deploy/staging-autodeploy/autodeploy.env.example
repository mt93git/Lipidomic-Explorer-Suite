# Copy to ~/.config/nexo-staging-autodeploy.env and fill in. Read by autodeploy.sh (and by the systemd unit).
# Checkouts of this repository that serve staging (the API's and the collaboration service's), and the client's web root.
NEXO_STAGING_API_DIR=
NEXO_STAGING_COLLAB_DIR=
NEXO_STAGING_DIST=
# Public host name of the site (wss URL baked into the client, and the Host header for the nginx check).
NEXO_STAGING_HOST=
# Where nginx listens on this machine.
NEXO_STAGING_NGINX=http://127.0.0.1
# Staging ports and systemd user units (defaults shown).
#NEXO_STAGING_API_PORT=3971
#NEXO_STAGING_COLLAB_PORT=3975
#NEXO_STAGING_UNITS="nexo-admin-staging.service nexo-collab-staging.service"
# Optional: a folder with the client's vendor files that are not in git (frontends/nexo/public/vendor).
#NEXO_VENDOR_DIR=
# R for the syntax check, and its library path if packages live outside the default one.
#RSCRIPT=Rscript
#R_LIBS_USER=
# Follow this pull request's branch while it is open, then its base branch (default 23).
#NEXO_AUTODEPLOY_PR=23
# Where state, status and logs go (default ~/staging-auto); skip a run below this much available memory (GB).
#NEXO_AUTODEPLOY_STATE=
#NEXO_AUTODEPLOY_MIN_FREE_GB=8
